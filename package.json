{
  "name": "wora-mobile",
  "version": "0.4.0-beta2",
  "private": true,
  "description": "A beautiful mobile music player for audiophiles with offline lyrics support",
  "author": {
    "name": "Aaryan Kapoor",
    "email": "hi.aaryankapoor@gmail.com"
  },
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:android": "expo prebuild --platform android && cd android && ./gradlew assembleDebug",
    "build:release": "expo prebuild --platform android && cd android && ./gradlew assembleRelease",
    "eject": "expo prebuild"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.1.1",
    "@react-native-async-storage/async-storage": "^2.0.0",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/native-stack": "^6.9.17",
    "axios": "^1.10.0",
    "expo": "~50.0.0",
    "expo-application": "~5.8.0",
    "expo-av": "~13.10.0",
    "expo-blur": "~12.8.0",
    "expo-build-properties": "~0.11.0",
    "expo-constants": "~15.4.0",
    "expo-device": "~5.8.0",
    "expo-file-system": "~15.8.0",
    "expo-haptics": "~12.8.0",
    "expo-image": "~1.11.0",
    "expo-image-picker": "~14.7.0",
    "expo-linear-gradient": "~12.7.0",
    "expo-media-library": "~15.8.0",
    "expo-sharing": "~11.10.0",
    "expo-sqlite": "~13.8.0",
    "expo-status-bar": "~1.11.0",
    "expo-system-ui": "~2.9.0",
    "expo-updates": "~0.24.0",
    "music-metadata": "^7.14.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-hook-form": "^7.58.1",
    "react-native": "0.73.0",
    "react-native-gesture-handler": "~2.14.0",
    "react-native-reanimated": "~3.6.0",
    "react-native-safe-area-context": "4.8.2",
    "react-native-screens": "~3.29.0",
    "react-native-vector-icons": "^10.0.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/music-metadata": "^2.1.0",
    "@types/react": "~18.2.45",
    "@types/react-native-vector-icons": "^6.4.18",
    "typescript": "^5.3.0"
  },
  "expo": {
    "name": "Wora",
    "slug": "wora",
    "version": "0.4.0-beta2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1a2e"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wora.player"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a1a2e"
      },
      "package": "com.wora.player",
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.MANAGE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-build-properties"
    ]
  }
}
